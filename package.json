{
  "name": "incidentai",
  "version": "1.0.0",
  "description": "IncidentAI — Autonomous AI Site Reliability Engineer & Self-Healing Incident Commander",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "bin": {
    "incidentai": "./dist/cli.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "start": "node dist/cli.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/cli.ts demo",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@yuva-devlab/logger": "^1.2.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@commitlint/types": "^19.5.0",
    "@types/node": "^24.10.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  }
}
